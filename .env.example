# DX BIOCODE Backend — Environment Variables
# Copy this file to .env.local for local development.
# In Vercel, add these via: Project → Settings → Environment Variables

# ── Neon PostgreSQL ──────────────────────────────────────────────
# Get from: https://console.neon.tech → Your Project → Connection Details
# Use the "Pooled connection" string (port 5432 with ?sslmode=require)
DATABASE_URL="postgresql://username:password@ep-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require"

# ── Resend (Email) ───────────────────────────────────────────────
# Get from: https://resend.com → API Keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# The "From" address — must match a verified domain in Resend.
# If your domain is not yet verified, use: onboarding@resend.dev (limited to your own email)
RESEND_FROM_EMAIL="DX BIOCODE <noreply@dxbiocode.com>"

# Internal email address that receives all lead/booking/application notifications
RESEND_TO_EMAIL="info@dxbiocode.com"

# ── Vercel Blob (Resume Storage) ─────────────────────────────────
# Get from: https://vercel.com → Your Project → Storage → Create Blob Store
# Then go to: .env.local tab → copy BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"

# ── CORS ─────────────────────────────────────────────────────────
# Your production frontend origin (used in CORS allow-list)
# The allow-list also automatically includes localhost:3000 and localhost:5500
ALLOWED_ORIGIN="https://dx-biocode-101.vercel.app"
